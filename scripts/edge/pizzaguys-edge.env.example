EDGE_API_PORT=4100
EDGE_API_HOST=0.0.0.0
CLOUD_API_URL=https://api.pizzaguys.example
EDGE_DB_PATH=/var/lib/pizzaguys/edge.sqlite
MOCK_PRINT_DIR=/var/lib/pizzaguys/prints
# Stampa: "mock" scrive i ticket in MOCK_PRINT_DIR; "network" li invia via TCP
# all'IP:porta di ogni stampante (Main Station → Impostazioni → Stampanti,
# solo Admin di sede). Porta standard 9100.
# Scontrino fiscale, Z-report e cassetto restano mock (RT Micrelec in Fase 7).
HARDWARE_BRIDGE_MODE=mock
# Copia non fiscale dello scontrino sulla stampante Bar a ogni incasso.
RECEIPT_COPY_PRINT=false

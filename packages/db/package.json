{
  "name": "@pizzaguys/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint ok'",
    "test": "echo 'no tests'",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit push",
    "seed": "tsx --env-file=../../.env src/seed.ts",
    "seed:menu": "tsx --env-file=../../.env src/seed-menu.ts",
    "seed:invoice-customers": "tsx --env-file=../../.env src/seed-invoice-customers.ts",
    "seed:discount-presets": "tsx --env-file=../../.env src/seed-discount-presets.ts",
    "patch:allergens": "tsx --env-file=../../.env src/patch-menu-allergens.ts",
    "patch:variants": "tsx --env-file=../../.env src/patch-menu-variants.ts",
    "patch:variants:reset": "tsx --env-file=../../.env src/patch-menu-variants-reset.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.44.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}

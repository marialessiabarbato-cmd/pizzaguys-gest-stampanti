# Pizza Guys - configurazione dell'Edge di questo PC (versione ZIP: questo file sta accanto a "Pizza Guys.exe").
# Dopo ogni modifica chiudi e riapri l'app. Non mettere questo file su GitHub.
# Attenzione: salva con il nome esatto "edge.env" (il Blocco note a volte aggiunge ".txt").
EDGE_API_PORT=4100
EDGE_API_HOST=0.0.0.0
# Indirizzo del Cloud a cui collegarsi (test: il Mac). Controlla l'IP del Mac se cambia rete.
CLOUD_API_URL=http://192.168.1.64:4000
# Stampa: "mock" salva i ticket su file, "network" li invia alle stampanti (IP in Impostazioni -> Stampanti).
HARDWARE_BRIDGE_MODE=mock
RECEIPT_COPY_PRINT=false
# Prima di stampare legge lo stato della stampante (carta, coperchio). "off" se una stampante
# non compatibile Epson stampa caratteri strani o rallenta.
PRINTER_STATUS_CHECK=on
# Se una stampante cambia indirizzo la cassa la ritrova da sola sulla rete (off per disattivare).
PRINTER_DISCOVERY=on
# Nome fisso della cassa in rete: palmari su http://pizzaguys-cassa.local:5174 (off per disattivare).
EDGE_MDNS_NAME=pizzaguys-cassa
# Finestra cassa: KIOSK=true la apre a schermo intero senza barre.
KIOSK=false
# Zoom della cassa: "auto" adatta la grandezza alla finestra; oppure un numero (0.8 = 80%). Ctrl e - / + lo cambiano da tastiera.
ZOOM=auto

{
  "name": "@pizzaguys/desktop",
  "version": "0.1.4",
  "private": true,
  "description": "Pizza Guys Gest — app Windows (Edge + cassa + palmare + KDS in un unico installatore)",
  "scripts": {
    "stage": "node scripts/stage.mjs",
